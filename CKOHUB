RunService.Heartbeat:Connect(function()
	local now = os.clock()
	if now - lastEspUpdate < 0.12 then return end
	lastEspUpdate = now

	local inLobby = estaEnLobby()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and espEnabled and isAlive(plr) and isEnemy(plr) and not inLobby then
			local character = plr.Character
			if not customHighlights[plr] or not customHighlights[plr].Parent then
				local ok, h = pcall(function()
					local hl = Instance.new("Highlight")
					hl.Name = "CKOHUB_HL"
					hl.Adornee = character
					hl.FillColor = espColor
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.45
					hl.OutlineTransparency = 0
					hl.Parent = safeEspFolder
					return hl
				end)
				if ok and h then customHighlights[plr] = h end
			else
				customHighlights[plr].Adornee = character
				customHighlights[plr].FillColor = espColor
			end
		else
			if customHighlights[plr] then
				pcall(function() customHighlights[plr]:Destroy() end)
				customHighlights[plr] = nil
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	if customHighlights[plr] then
		pcall(function() customHighlights[plr]:Destroy() end)
		customHighlights[plr] = nil
	end
	clearHitboxes(plr.Character)
end)

