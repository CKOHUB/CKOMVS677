end)

-- ========== AUTO SHOOT ==========
local autoShootConn
local function stopAutoShoot()
	if autoShootConn then
		autoShootConn:Disconnect()
		autoShootConn = nil
	end
end

local function startAutoShoot()
	stopAutoShoot()
	autoShootConn = RunService.Heartbeat:Connect(function()
		if not (autoShootEnabled or autoShootAgresivo) then return end
		if estaEnLobby() then return end
		local char = player.Character
		if not char or not isAlive(player) then return end

		local enemy, part = getClosestEnemy(autoShootRange)
		if not enemy or not part then return end
		env.CKOHUBTargetPart = part

		local gun = getGun()
		if not gun then return end

		if gun.Parent == player:FindFirstChild("Backpack") then
			pcall(function()
				char:FindFirstChildOfClass("Humanoid"):EquipTool(gun)
			end)
			return
		end

		fireGun(gun)
		if autoShootAgresivo then
			pcall(function() gun:Activate() end)
		end
	end)
end

-- ========== KILL ALL ==========
local killAllConn
local function stopKillAll()
	if killAllConn then
		killAllConn:Disconnect()
		killAllConn = nil
	end
end

local function startKillAll()
	stopKillAll()
	killAllConn = RunService.Heartbeat:Connect(function()
		if not killAllEnabled then return end
		if estaEnLobby() then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp or not isAlive(player) then return end

		local enemy, part = getClosestEnemy(400)
		if not enemy or not part then return end

		local offset = Vector3.new((math.random() - 0.5) * 4, 0, (math.random() - 0.5) * 4)
		pcall(function()
			hrp.CFrame = CFrame.new(part.Position + offset + Vector3.new(0, 2, 0))
		end)

		env.CKOHUBTargetPart = part
		local gun = getGun()
		if gun then
			if gun.Parent == player:FindFirstChild("Backpack") then
				pcall(function()
					char:FindFirstChildOfClass("Humanoid"):EquipTool(gun)
				end)
			else
				fireGun(gun)
			end
		end
	end)
end

-- ========== HITBOX ==========
RunService.Heartbeat:Connect(function()
	if not hitboxEnabled then return end
	local now = os.clock()
	if now - lastHitboxUpdate < 0.06 then return end
	lastHitboxUpdate = now

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and isEnemy(plr) and isAlive(plr) then
			local character = plr.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local p = character:FindFirstChild("GhostHitbox")
				if not p then
					p = Instance.new("Part")
					p.Name = "GhostHitbox"
					p.Size = hitboxSizeVector
					p.Transparency = 0.65
					p.CanCollide = false
					p.Massless = true
					p.Material = Enum.Material.ForceField
					p.Color = Color3.fromRGB(255, 80, 80)
					p.CFrame = root.CFrame
					p.Parent = character
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = root
					weld.Part1 = p
					weld.Parent = p
				else
					p.Size = hitboxSizeVector
				end
			end
		else
			clearHitboxes(plr.Character)
		end
	end
end)

